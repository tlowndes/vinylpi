# Vinyl Pi: a native unit for Icecast. Debian only ships an old init.d script, which
# newer systemd versions are dropping. This file takes precedence over it.
[Unit]
Description=Icecast streaming server
After=network.target vinyl-firstboot.service

[Service]
Type=simple
User=icecast2
Group=icecast
ExecStart=/usr/bin/icecast2 -c /etc/icecast2/icecast.xml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
