[Unit]
Description=Vinyl Pi: web app on port 80
After=network-online.target icecast2.service
Wants=network-online.target

[Service]
Type=simple
User=vinyl
Group=vinyl
WorkingDirectory=/opt/vinyl-pi/app
ExecStart=/opt/vinyl-pi/.venv/bin/python /opt/vinyl-pi/app/server.py
Environment=PYTHONUNBUFFERED=1
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
